---
import { toHtml } from "@draftbase/renderer";
import Base from "../layouts/Base.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import Cta from "../components/Cta.astro";
import {
	getAll,
	url,
	type Education,
	type Experience,
	type Profile,
	type Project,
	type Skill,
} from "../lib/draftbase";

const [[profile], projects, jobs, studies, skills] = await Promise.all([
	getAll<Profile>("profile"),
	getAll<Project>("project"),
	getAll<Experience>("experience"),
	getAll<Education>("education"),
	getAll<Skill>("skill"),
]);
const byOrder = <T extends { fields: { order?: number } }>(list: T[]) =>
	list.sort((a, b) => (a.fields.order ?? 0) - (b.fields.order ?? 0));
projects.sort(
	(a, b) =>
		(b.fields.year ?? 0) - (a.fields.year ?? 0) ||
		Number(b.fields.featured ?? false) - Number(a.fields.featured ?? false),
);
byOrder(jobs);
const jobsHtml = await Promise.all(jobs.map((j) => toHtml(j.fields.description ?? "")));
const bio = profile ? await toHtml(profile.fields.bio) : "";
const f = profile?.fields;
const name = f?.name ?? "Portafolio";
// Foto: la del CMS si existe; si no, la de public/.
const avatar = f?.avatar?.url ?? url("sergio.png");
const stats = [
	[`${projects.length}`, "Proyectos"],
	["50+", "Pantallas Flutter"],
	["Sem. 7", "Ing. de Sistemas"],
];
const tabs = [
	["portfolio", "Portafolio"],
	["about", "Sobre mí"],
	["experience", "Experiencia"],
	["education", "Estudios"],
	["skills", "Habilidades"],
	["contact", "Contacto"],
];
const site = new URL(url(), Astro.site).href;
const schema = [
	{
		"@context": "https://schema.org",
		"@type": "ProfilePage",
		mainEntity: {
			"@type": "Person",
			name,
			jobTitle: f?.headline,
			description: f?.headline,
			url: site,
			address: f?.location,
			telephone: f?.phone,
			email: f?.email ? `mailto:${f.email}` : undefined,
			sameAs: [f?.githubUrl, f?.linkedinUrl].filter(Boolean),
		},
	},
];
const ghPath =
	"M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z";
const liPath =
	"M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.84-2 3.8-2 4.06 0 4.8 2.67 4.8 6.14V21h-4v-5.07c0-1.2-.02-2.76-1.68-2.76-1.68 0-1.94 1.31-1.94 2.67V21h-4z";
---

<Base
	title={`${name} — ${f?.headline ?? "Portafolio"}`}
	description={f?.headline}
	image={avatar}
	ogType="profile"
	name={name}
	schema={schema}
>
	<div class="col profile">
		<section class="who narrow">
			<img class="avatar" src={avatar} alt={name} width="108" height="108" />
			<div>
				<h1>{name}</h1>
				<p class="role">{f?.headline}</p>
				<div class="socials">
					{
						f?.githubUrl && (
							<a href={f.githubUrl} aria-label="GitHub" rel="noopener noreferrer">
								<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
									<path d={ghPath} />
								</svg>
							</a>
						)
					}
					{
						f?.linkedinUrl && (
							<a href={f.linkedinUrl} aria-label="LinkedIn" rel="noopener noreferrer">
								<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
									<path d={liPath} />
								</svg>
							</a>
						)
					}
				</div>
			</div>
		</section>

		<section class="stats narrow">
			{
				stats.map(([n, label]) => (
					<div>
						<b>{n}</b>
						<span>{label}</span>
					</div>
				))
			}
		</section>

		<section class="actions narrow">
			<a class="btn primary" href={url("CV_Sergio_Velasquez.pdf")} download>
				Descargar CV
				<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"
					><path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"></path></svg
				>
			</a>
			{
				f?.linkedinUrl && (
					<a class="btn square" href={f.linkedinUrl} aria-label="LinkedIn" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
							<path d={liPath} />
						</svg>
					</a>
				)
			}
			{
				f?.email && (
					<a class="btn square" href={`mailto:${f.email}`} aria-label="Correo">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
							<path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
						</svg>
					</a>
				)
			}
		</section>

		<div class="tabs" role="tablist">
			{
				tabs.map(([id, label], i) => (
					<button role="tab" id={`tab-${id}`} aria-controls={id} aria-selected={i === 0 ? "true" : "false"}>
						{label}
					</button>
				))
			}
		</div>

		<section class="panel" id="portfolio" role="tabpanel" aria-labelledby="tab-portfolio">
			<h2>Proyectos</h2>
			<ProjectGrid projects={projects} />
			<Cta email={f?.email} />
		</section>

		<section class="panel" id="about" role="tabpanel" aria-labelledby="tab-about" hidden>
			<h2>Sobre mí</h2>
			<div class="db-content" set:html={bio} />
			<Cta email={f?.email} />
		</section>

		<section class="panel" id="experience" role="tabpanel" aria-labelledby="tab-experience" hidden>
			<h2>Experiencia</h2>
			<div class="timeline">
				{
					jobs.map((job, i) => (
						<article class="tl-card">
							<h3><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 6h-4V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2zM10 4h4v2h-4V4z" /></svg>{job.fields.role}</h3>
							<p class="line"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10z" /></svg>{job.fields.company}</p>
							{job.fields.location && <p class="line"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" /></svg>{job.fields.location}</p>}
							{job.fields.period && <p class="line"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z" /></svg><span class="badge">{job.fields.period}</span></p>}
							<div class="db-content" set:html={jobsHtml[i]} />
							{job.fields.tags && <ul class="chips outline">{job.fields.tags.split(",").map((t) => <li>{t.trim()}</li>)}</ul>}
						</article>
					))
				}
			</div>
			<Cta email={f?.email} />
		</section>

		<section class="panel" id="education" role="tabpanel" aria-labelledby="tab-education" hidden>
			<h2>Estudios</h2>
			<div class="timeline">
				{
					byOrder(studies).map((st) => (
						<article class="tl-card">
							<h3><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" /></svg>{st.fields.degree}</h3>
							<p class="line"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10z" /></svg>{st.fields.institution}</p>
							{st.fields.period && <p class="line"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z" /></svg><span class="badge">{st.fields.period}</span></p>}
							<p>{st.fields.description}</p>
							{st.fields.tags && <ul class="chips outline">{st.fields.tags.split(",").map((t) => <li>{t.trim()}</li>)}</ul>}
						</article>
					))
				}
			</div>
			<Cta email={f?.email} />
		</section>

		<section class="panel" id="skills" role="tabpanel" aria-labelledby="tab-skills" hidden>
			<h2>Habilidades</h2>
			{
				byOrder(skills).map((s) => (
					<div class="skill-row">
						<h3>{s.fields.category}</h3>
						<ul class="chips">
							{s.fields.items.split(",").map((t) => <li>{t.trim()}</li>)}
						</ul>
					</div>
				))
			}
			<Cta email={f?.email} />
		</section>

		<section class="panel" id="contact" role="tabpanel" aria-labelledby="tab-contact" hidden>
			<h2>Contacto</h2>
			<ul class="contact-list">
				{f?.email && <li><b>Correo</b><a href={`mailto:${f.email}`}>{f.email}</a></li>}
				{f?.phone && <li><b>Teléfono</b><a href={`tel:${f.phone.replace(/\s/g, "")}`}>{f.phone}</a></li>}
				{f?.location && <li><b>Ubicación</b><span>{f.location}</span></li>}
				{f?.githubUrl && <li><b>GitHub</b><a href={f.githubUrl} rel="noopener noreferrer">{f.githubUrl.replace("https://", "")}</a></li>}
				{f?.linkedinUrl && <li><b>LinkedIn</b><a href={f.linkedinUrl} rel="noopener noreferrer">{f.linkedinUrl.replace("https://", "")}</a></li>}
			</ul>
			<Cta email={f?.email} />
		</section>
	</div>

	<script is:inline>
		(function () {
			var tabs = document.querySelectorAll('.tabs [role="tab"]');
			function show(id) {
				tabs.forEach(function (t) {
					var on = t.getAttribute("aria-controls") === id;
					t.setAttribute("aria-selected", on ? "true" : "false");
					document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
				});
			}
			tabs.forEach(function (t) {
				t.addEventListener("click", function () {
					var id = t.getAttribute("aria-controls");
					show(id);
					history.replaceState(null, "", "#" + id);
				});
			});
			var h = location.hash.slice(1);
			if (h && document.getElementById(h) && document.getElementById(h).getAttribute("role") === "tabpanel") show(h);
		})();
	</script>
</Base>
