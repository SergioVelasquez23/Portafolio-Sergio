---
import { toHtml } from "@draftbase/renderer";
import Cta from "../../components/Cta.astro";
import Base from "../../layouts/Base.astro";
import { getAll, mediaSrc, url, type Profile, type Project } from "../../lib/draftbase";

export async function getStaticPaths() {
	const [projects, [profile]] = await Promise.all([
		getAll<Project>("project"),
		getAll<Profile>("profile"),
	]);
	return projects.map((project) => ({
		params: { slug: project.fields.slug },
		props: { project, profile },
	}));
}

const { project, profile } = Astro.props;
const body = await toHtml(project.fields.body ?? "");
const name = profile?.fields.name ?? "Portfolio";
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
	{
		"@context": "https://schema.org",
		"@type": "CreativeWork",
		name: project.fields.title,
		description: project.fields.summary,
		url: canonical,
		image: mediaSrc(project.fields.cover) ?? undefined,
		dateCreated: project.fields.year ? String(project.fields.year) : undefined,
		author: { "@type": "Person", name },
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: "Work",
				item: new URL(url(), Astro.site).href,
			},
			{ "@type": "ListItem", position: 2, name: project.fields.title, item: canonical },
		],
	},
];
---

<Base
	title={project.fields.title}
	description={project.fields.summary}
	image={mediaSrc(project.fields.cover)}
	ogType="article"
	name={name}
	schema={schema}
>
	<article class="article">
		<a class="muted" href={url("projects")} style="font-size:13px">← Todos los proyectos</a>
		<h1>{project.fields.title}</h1>
		<p class="muted">
			{project.fields.year}
			{
				project.fields.liveUrl && (
					<>
						{" · "}
						<a href={project.fields.liveUrl} rel="noopener noreferrer">
							Ver sitio
						</a>
					</>
				)
			}
		</p>
		{
			project.fields.tech && (
				<ul class="chips">
					{project.fields.tech.split(",").map((t) => <li>{t.trim()}</li>)}
				</ul>
			)
		}
		{
			mediaSrc(project.fields.cover) && (
				<img
					src={mediaSrc(project.fields.cover)!}
					alt={project.fields.cover.altText ?? project.fields.title}
					style="margin:24px 0"
				/>
			)
		}
		<div class="db-content" set:html={body} />
		<Cta email={profile?.fields.email} />
	</article>
</Base>
